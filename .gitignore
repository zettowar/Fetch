# Environment — ignore every .env variant/backup (.env.bak, .env.save, .env.local,
# .env.production, …), but keep the tracked template.
.env
.env.*
!.env.example
*.env.local

# Stray secrets & DB dumps that must never be committed (e.g. predeploy-*.dump,
# on-box .env backups). Belt-and-suspenders alongside the .env.* rule above.
*.bak
*.dump
*.sql.gz

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
frontend/node_modules/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker
uploads/

# Claude
.claude/

# Local business artifacts — kept out of the (public) repo
financials/
.prior_audit_titles.txt
