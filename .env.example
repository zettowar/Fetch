# Backend
# ENVIRONMENT gates prod-only safety checks. When set to "production" the app
# refuses to start with DEBUG_RESET_TOKEN/DEBUG_VERIFY_TOKEN enabled.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://fetch:fetch@db:5432/fetch

# Postgres container credentials (docker-compose.prod.yml requires
# POSTGRES_PASSWORD to be set). The user/password/db here MUST match the
# credentials embedded in DATABASE_URL above — they are two views of the same
# connection.
POSTGRES_USER=fetch
POSTGRES_PASSWORD=
POSTGRES_DB=fetch
# JWT_SECRET must be unique and at least 32 characters — generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-32plus-char-random-string-generated-locally
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/uploads
# Comma-separated explicit origins. Cannot be "*" (credentials are allowed).
CORS_ORIGINS=http://localhost:3174
RATE_LIMIT_ENABLED=true
# Beta gate: require an admin-generated invite code at signup. Defaults off in
# dev; docker-compose.prod.yml defaults it ON for production.
INVITE_REQUIRED=false

# Dev-only: return password-reset / email-verification tokens in API responses
# so those flows can be tested without an email provider. Must stay false in
# production (the app refuses to boot with ENVIRONMENT=production + either true).
DEBUG_RESET_TOKEN=false
DEBUG_VERIFY_TOKEN=false

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Observability (leave empty to disable)
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json

# Moderation (leave empty for stub/approve-all mode)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Transactional email — Resend (https://resend.com), HTTPS API so it works on
# hosts that block SMTP (e.g. DigitalOcean). Leave the key empty to disable
# email: sends are logged and skipped, and the lost-dog contact relay returns
# 503. With a key set, signup/reset/verify emails and lost-dog alerts go out.
# EMAIL_FROM must be a sender on a domain you verified in Resend; the
# onboarding@resend.dev sandbox sender works out of the box but only delivers
# to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM=Fetchpawz <onboarding@resend.dev>
# Absolute origin used for links inside emails (reset/verify/report pages).
# Set to your real site origin in production, e.g. https://fetchpawz.com
FRONTEND_BASE_URL=http://localhost:3174

# --- Monitoring (docker compose --profile monitoring) ---
# Prometheus scrapes the backend's /metrics on the internal network (nginx does
# not proxy it, so it is never public) and Alertmanager POSTs firing alerts to
# the backend, which emails them via Resend — DigitalOcean blocks outbound SMTP,
# so Alertmanager cannot mail directly.
# Where alerts are emailed. Empty = alerts are logged only.
ALERT_EMAIL_TO=
# Shared bearer token Alertmanager presents to /admin/alerts/webhook.
# Empty = the webhook is disabled (401) and the alertmanager container refuses
# to start. Generate with: openssl rand -hex 32
ALERT_WEBHOOK_TOKEN=
# Port the Celery worker exposes its own metrics on for Prometheus to scrape.
# Bulk email (digest, announcements, weekly recap) is sent from Celery, not the
# web process, so without this second target the email alerts can only ever see
# transactional mail. 0 disables the exporter.
CELERY_METRICS_PORT=9100

# Donations via Stripe Checkout. Empty STRIPE_SECRET_KEY = donations disabled:
# /donations endpoints return 503 and the UI shows rescues' external donation
# links only. With a key set, also create a webhook endpoint in the Stripe
# dashboard pointing at https://<your-domain>/api/v1/donations/webhook
# (events: checkout.session.completed, checkout.session.expired,
# charge.refunded) and put its whsec_ signing secret here — required in
# production, or payments would never be confirmed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional second endpoint (type "Connected accounts", event account.updated)
# for instant rescue-onboarding sync; status also self-heals on read.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Percent of each rescue donation kept by the platform (0 = pass-through).
DONATION_PLATFORM_FEE_PERCENT=0

# SSO / OAuth (Google + GitHub). Empty client id/secret = that provider is
# unavailable. The whole feature is ALSO gated by the admin `sso_enabled` flag
# (Admin -> Settings), which defaults OFF — so buttons stay hidden and the
# endpoints 404 until you switch it on. Steps:
#   1. Google:  console.cloud.google.com -> APIs & Services -> Credentials ->
#      OAuth client ID (type "Web application").
#      GitHub:  github.com/settings/developers -> New OAuth App.
#   2. Register the callback (Authorized redirect URI):
#        dev:  http://localhost:9001/api/v1/auth/oauth/<google|github>/callback
#        prod: https://<DOMAIN>/api/v1/auth/oauth/<google|github>/callback
#   3. Paste the client id/secret below, set OAUTH_REDIRECT_BASE to match, then
#      flip `sso_enabled` on in Admin -> Settings.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# The backend's own public origin (callback is appended to it, and must match
# what you registered above). Dev: http://localhost:9001 ; prod: https://<DOMAIN>
OAUTH_REDIRECT_BASE=http://localhost:9001

# Production TLS + backups (docker-compose.prod.yml only)
# DOMAIN is the public hostname Caddy provisions a Let's Encrypt cert for —
# DNS for it must point at the droplet before first boot. Use "localhost" to
# smoke-test the prod stack without DNS (self-signed cert).
DOMAIN=
# Days of daily pg_dump files to keep in the db_backups volume.
BACKUP_KEEP_DAYS=14

# Frontend
# Dev: the Vite server proxies to the backend on this URL. Production
# (docker-compose.prod.yml): leave EMPTY — the SPA then calls the relative
# /api/v1, which nginx proxies to the backend container.
VITE_API_BASE_URL=http://localhost:9001/api/v1
# Absolute site origin baked into social-share meta tags (og:image). Set to
# your public origin in production, e.g. https://fetchpawz.com — link previews
# on some platforms require an absolute image URL. Empty = relative path.
VITE_SITE_URL=
# Set to "false" to disable third-party IP geolocation (ipapi.co) used to
# pre-center maps before the user grants precise location. Defaults to enabled.
VITE_ENABLE_IP_GEOLOCATION=true
# Raster map tile template for the parks/vets/rescues/lost-pet maps. Empty falls
# back to tile.openstreetmap.org, which is fine for dev but whose usage policy
# forbids production/commercial traffic — point this at a paid provider before
# launch (e.g. https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=YOURKEY
# or a Stadia/Thunderforest URL). Baked at build time like every VITE_ var.
VITE_MAP_TILE_URL=

# Shop / Shopify Storefront (leave empty to run the shop in demo mode with a
# sample catalog + local cart — no Shopify account required).
# Domain is the *.myshopify.com host; token is a Storefront API access token.
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
