# Backend
# ENVIRONMENT gates prod-only safety checks. When set to "production" the app
# refuses to start with DEBUG_RESET_TOKEN/DEBUG_VERIFY_TOKEN enabled.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://fetch:fetch@db:5432/fetch

# Postgres container credentials (docker-compose.prod.yml requires
# POSTGRES_PASSWORD to be set). The user/password/db here MUST match the
# credentials embedded in DATABASE_URL above — they are two views of the same
# connection.
POSTGRES_USER=fetch
POSTGRES_PASSWORD=
POSTGRES_DB=fetch
# JWT_SECRET must be unique and at least 32 characters — generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-32plus-char-random-string-generated-locally
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/uploads
# Comma-separated explicit origins. Cannot be "*" (credentials are allowed).
CORS_ORIGINS=http://localhost:3174
RATE_LIMIT_ENABLED=true
# Beta gate: require an admin-generated invite code at signup. Defaults off in
# dev; docker-compose.prod.yml defaults it ON for production.
INVITE_REQUIRED=false

# Dev-only: return password-reset / email-verification tokens in API responses
# so those flows can be tested without an email provider. Must stay false in
# production (the app refuses to boot with ENVIRONMENT=production + either true).
DEBUG_RESET_TOKEN=false
DEBUG_VERIFY_TOKEN=false

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Observability (leave empty to disable)
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FORMAT=json

# Moderation (leave empty for stub/approve-all mode)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Frontend
# Dev: the Vite server proxies to the backend on this URL. Production
# (docker-compose.prod.yml): leave EMPTY — the SPA then calls the relative
# /api/v1, which nginx proxies to the backend container.
VITE_API_BASE_URL=http://localhost:9001/api/v1
# Set to "false" to disable third-party IP geolocation (ipapi.co) used to
# pre-center maps before the user grants precise location. Defaults to enabled.
VITE_ENABLE_IP_GEOLOCATION=true

# Shop / Shopify Storefront (leave empty to run the shop in demo mode with a
# sample catalog + local cart — no Shopify account required).
# Domain is the *.myshopify.com host; token is a Storefront API access token.
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
