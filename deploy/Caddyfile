# TLS terminator for the production stack. Caddy provisions and renews
# Let's Encrypt certificates for {$DOMAIN} automatically and redirects
# HTTP -> HTTPS. DOMAIN=localhost gets a self-signed local cert, handy for
# smoke-testing the prod stack without DNS.
{$DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy frontend:8080 {
		# Caddy is the sole public edge. Overwrite X-Forwarded-For with the real
		# peer address so a client-supplied header can't survive downstream and
		# spoof the source IP used for rate limiting and audit logs.
		header_up X-Forwarded-For {remote_host}
	}
}
